#!/bin/sh

launchctl unload /var/jb/Library/LaunchDaemons/dev.adrian.autoinstall.device-agent.plist >/dev/null 2>&1 || true
launchctl load /var/jb/Library/LaunchDaemons/dev.adrian.autoinstall.device-agent.plist >/dev/null 2>&1 || launchctl bootstrap system /var/jb/Library/LaunchDaemons/dev.adrian.autoinstall.device-agent.plist >/dev/null 2>&1 || true
exit 0
