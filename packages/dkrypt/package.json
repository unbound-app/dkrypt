{
  "name": "dkrypt-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.2"
  },
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "start": "bun src/server.ts",
    "dev": "bun --watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "stripe:seed": "bun scripts/seed-stripe-catalog.ts",
    "stripe:webhook": "bun scripts/configure-stripe-webhook.ts",
    "build:web": "cd web && bun install --frozen-lockfile && bun run build",
    "typecheck:web": "cd web && bun install --frozen-lockfile && bun run typecheck"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "@fastify/static": "^10.1.2",
    "@scalar/fastify-api-reference": "^1.63.0",
    "adm-zip": "^0.6.0",
    "bplist-parser": "^0.3.2",
    "cron-parser": "^5",
    "discord-api-types": "^0.38.52",
    "fastify": "^5.10.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "plist": "^5.0.0",
    "safe-regex2": "^5.1.1",
    "ssh2": "^1.17.0",
    "stripe": "^20.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/ssh2": "^1.15.5",
    "@types/web-push": "^3.6.4",
    "bun-types": "^1.2.0",
    "typescript": "^5.7.2"
  }
}
