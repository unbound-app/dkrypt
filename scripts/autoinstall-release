#!/bin/zsh
set -euo pipefail

root_dir="$(cd "$(dirname "$0")/.." && pwd)"
mode="${1:-deploy}"
package_path="${2:-}"
target="${AUTOINSTALL_IDEVICE_TARGET:-}"
key_path="${AUTOINSTALL_IDEVICE_KEY:-$HOME/.ssh/id_ed25519}"
ssh_options=(-i "$key_path" -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new)

if [[ -z "$target" ]]; then
  print -u2 "set AUTOINSTALL_IDEVICE_TARGET to mobile@<device-address>"
  exit 64
fi

is_semver() {
  [[ "$1" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]
}

is_greater_version() {
  local left="$1"
  local right="$2"
  local left_major left_minor left_patch right_major right_minor right_patch
  IFS=. read -r left_major left_minor left_patch <<< "$left"
  IFS=. read -r right_major right_minor right_patch <<< "$right"
  (( left_major > right_major || (left_major == right_major && left_minor > right_minor) || (left_major == right_major && left_minor == right_minor && left_patch > right_patch) ))
}

control_version="$(awk -F': ' '$1 == "Version" { print $2 }' "$root_dir/packages/autoinstall/control")"
if ! is_semver "$control_version"; then
  print -u2 "autoinstall version must be strict semantic versioning (MAJOR.MINOR.PATCH): $control_version"
  exit 64
fi

if [[ "$mode" == "deploy" ]]; then
  expected_version="$control_version"
  gmake -C "$root_dir/packages/autoinstall" clean package
  package_path="$root_dir/packages/autoinstall/packages/dev.adrian.autoinstall_${expected_version}_iphoneos-arm64.deb"
  if [[ ! -f "$package_path" ]]; then
    print -u2 "autoinstall build did not produce the expected semantic-versioned package: $package_path"
    exit 1
  fi
elif [[ "$mode" != "rollback" || ! -f "$package_path" ]]; then
  print -u2 "usage: $0 deploy | $0 rollback /absolute/path/to/dev.adrian.autoinstall_*.deb"
  exit 64
else
  package_name="$(basename "$package_path")"
  if [[ "$package_name" != dev.adrian.autoinstall_*_iphoneos-arm64.deb ]]; then
    print -u2 "rollback package has an unexpected filename: $package_name"
    exit 64
  fi
  expected_version="${package_name#dev.adrian.autoinstall_}"
  expected_version="${expected_version%_iphoneos-arm64.deb}"
  if ! is_semver "$expected_version"; then
    print -u2 "rollback package version must be strict semantic versioning: $expected_version"
    exit 64
  fi
fi

previous_version="$(ssh "${ssh_options[@]}" "$target" "dpkg-query -W -f='\${Version}' dev.adrian.autoinstall 2>/dev/null || true")"
if [[ "$mode" == "deploy" && -n "$previous_version" ]]; then
  if ! is_semver "$previous_version"; then
    print -u2 "installed autoinstall version is not semantic versioning: $previous_version"
    exit 1
  fi
  if ! is_greater_version "$expected_version" "$previous_version"; then
    print -u2 "autoinstall version must increase: $previous_version -> $expected_version"
    exit 1
  fi
fi
previous_package=""
if [[ -n "$previous_version" ]]; then
  previous_package="$(ls -t "$root_dir"/packages/autoinstall/packages/dev.adrian.autoinstall_"$previous_version"_iphoneos-arm64.deb 2>/dev/null | head -n 1 || true)"
fi
remote_package="/tmp/$(basename "$package_path")"
install_package() {
  local package="$1"
  local remote="/tmp/$(basename "$package")"
  scp "${ssh_options[@]}" "$package" "$target:$remote"
  ssh -tt "${ssh_options[@]}" "$target" "sudo dpkg -i '$remote' && { sudo killall -9 AppStore TestFlight 2>/dev/null || true; } && sudo /var/jb/usr/bin/sbreload"
}

rollback() {
  if [[ -z "$previous_package" ]]; then
    print -u2 "autoinstall deployment verification failed and no local rollback package is available"
    return
  fi
  install_package "$previous_package"
  print -u2 "autoinstall deployment verification failed; restored $previous_version"
}

install_package "$package_path"
installed_version="$(ssh "${ssh_options[@]}" "$target" "dpkg-query -W -f='\${Version}' dev.adrian.autoinstall")"
if [[ "$installed_version" != "$expected_version" ]]; then
  rollback
  exit 1
fi
agent_ready=false
for _ in {1..15}; do
  if ssh "${ssh_options[@]}" "$target" "test -x /var/jb/usr/libexec/autoinstall-device-agent && { launchctl print user/501/dev.adrian.autoinstall.device-agent >/dev/null 2>&1 || ps ax | grep -q '[a]utoinstall-device-agent'; }"; then
    agent_ready=true
    break
  fi
  sleep 2
done
if [[ "$agent_ready" != true ]]; then
  rollback
  exit 1
fi
heartbeat_ready=false
for _ in {1..15}; do
  if ssh "${ssh_options[@]}" "$target" "test -s /tmp/autoinstall/v1/springboard/state/heartbeat.json && grep -Fq '\"bridgeVersion\" : \"$expected_version\"' /tmp/autoinstall/v1/springboard/state/heartbeat.json"; then
    heartbeat_ready=true
    break
  fi
  sleep 2
done
if [[ "$heartbeat_ready" != true ]]; then
  rollback
  exit 1
fi
print "autoinstall $installed_version installed on $target"
